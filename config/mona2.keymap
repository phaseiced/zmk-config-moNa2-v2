#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        MouseLayer {
            bindings = <&tog 3>;
            key-positions = <41 39>;
        };

        ToLayer6 {
            bindings = <&to 4>;
            key-positions = <40 41>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp B           &kp L                   &kp D              &kp C             &kp V                                           &kp J          &kp Y              &kp O        &kp U            &kp SEMICOLON
&mt LEFT_WIN N  &mt LEFT_ALT R          &mt LCTRL T        &mt LEFT_SHIFT S  &kp G                                &kp F13    &kp P          &mt RIGHT_SHIFT H  &mt RCTRL A  &mt RIGHT_ALT E  &mt RIGHT_WIN I
&kp X           &kp Q                   &kp M              &kp W             &kp Z        &kp LC(LS(S))           &kp F15    &kp K          &kp F              &kp COMMA    &kp DOT          &kp SLASH
&kp CAPS        &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT))  &kp ESCAPE        &lt 1 SPACE  &lt_to_layer_0 2 TAB    &kp ENTER  &kp BACKSPACE                                                   &kp DELETE
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        Number {
            bindings = <
&kp F2          &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp NUMBER_5                        &kp GRAVE  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH
&trans          &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans                   &trans     &trans     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK
&kp LEFT_SHIFT  &trans        &trans            &trans             &trans        &trans     &trans     &trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS
&kp LCTRL       &kp F4        &kp F2            &kp ESCAPE         &kp SPACE     &kp TAB    &kp ENTER  &kp N0                                               &kp PLUS
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_3 {
            bindings = <
&trans  &kp LC(LS(TAB))     &kp PRINTSCREEN         &kp LC(TAB)              &trans                                     &trans  &kp HOME        &kp UP_ARROW    &kp END          &trans
&trans  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)     &kp LC(LG(LEFT_ARROW))   &kp LC(LG(RIGHT_ARROW))            &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &kp LEFT_SHIFT      &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &trans                   &trans    &trans  &trans  &kp DELETE      &kp PAGE_UP     &kp PAGE_DOWN    &trans
&trans  &trans              &trans                  &trans                   &trans                   &trans    &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        MOUSE {
            bindings = <
&trans          &trans  &trans  &trans  &trans                    &trans  &kp HOME        &kp UP_ARROW    &kp END          &kp K_COPY
&trans          &trans  &trans  &trans  &trans            &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp K_PASTE
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp MCLK       &mkp LCLK       &mkp RCLK        &kp PAGE_UP
&kp LCTRL       &trans  &trans  &trans  &trans  &to 0     &trans  &trans                                                   &kp PAGE_DOWN
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        Connection {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                                &bt BT_CLR_ALL  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                          &bt BT_CLR  &trans          &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &studio_unlock    &trans      &trans          &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &to 0             &trans      &trans                                  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
